[Unit]
Description=Mac NAS Guardian
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/mac-nas-guardian/app/guardian_agent.py --config /etc/mac-nas-guardian/config.json
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
